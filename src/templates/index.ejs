<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= brandName %></title>
  <link rel="stylesheet" href="style.css">
  <!-- Add Google Fonts based on schema -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=<%= font.heading.replace(' ', '+') %>&family=<%= font.body.replace(' ', '+') %>&display=swap" rel="stylesheet">
</head>
<body>
  <header>
    <div class="container">
      <div class="brand">
        <h1><%= brandName %></h1>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h2><%= copyBlocks.headline %></h2>
        <p class="subheadline"><%= copyBlocks.subheadline %></p>
        <div class="cta-container">
          <a href="#contact" class="cta-button"><%= copyBlocks.callToAction %></a>
        </div>
      </div>
      <div class="hero-image">
        <% if (generatedImages && generatedImages.hero) { %>
          <img src="<%= generatedImages.hero %>" alt="<%= imagePrompts.hero %>" class="generated-image">
        <% } else { %>
        <!-- In a real implementation, we would use the imagePrompts to generate images -->
        <div class="placeholder-image" aria-label="<%= imagePrompts.hero %>">
          <!-- Placeholder for hero image -->
        </div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="feature main-feature">
        <div class="feature-image">
          <% if (generatedImages && generatedImages.feature1) { %>
            <img src="<%= generatedImages.feature1 %>" alt="<%= imagePrompts.feature1 %>" class="generated-image">
          <% } else { %>
          <!-- In a real implementation, we would use the imagePrompts to generate images -->
          <div class="placeholder-image" aria-label="<%= imagePrompts.feature1 %>">
            <!-- Placeholder for feature image -->
          </div>
          <% } %>
        </div>
        <div class="feature-content">
          <h3>Key Feature</h3>
          <p><%= copyBlocks.valueProposition %></p>
        </div>
      </div>

      <% if (copyBlocks.featuresList && copyBlocks.featuresList.length > 0) { %>
      <div class="features-list">
        <h3>Features</h3>
        <ul>
          <% copyBlocks.featuresList.forEach(function(feature) { %>
            <li><%= feature %></li>
          <% }); %>
        </ul>
      </div>
      <% } %>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="container">
      <h2><%= formText.title %></h2>
      
      <!-- Netlify Form - with required attributes -->
      <form data-netlify="true" name="contact" method="POST">
        <!-- Hidden input for Netlify form name -->
        <input type="hidden" name="form-name" value="contact">
        
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required>
        </div>
        
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>
        
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        
        <button type="submit" class="submit-button"><%= formText.submitButton %></button>
      </form>
    </div>
  </section>

  <footer>
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> <%= brandName %>. All rights reserved.</p>
    </div>
  </footer>
</body>
</html> 