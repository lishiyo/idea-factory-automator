/* Base CSS for landing page */
:root {
  --color-primary: <%= palette.primary %>;
  --color-secondary: <%= palette.secondary %>;
  --color-accent: <%= palette.accent %>;
  --font-heading: '<%= font.heading %>', sans-serif;
  --font-body: '<%= font.body %>', sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-body);
  line-height: 1.6;
  color: #333;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  margin-bottom: 1rem;
  color: var(--color-primary);
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 0;
}

/* Hero Section */
.hero {
  background-color: var(--color-secondary);
  color: white;
  text-align: center;
  padding: 4rem 0;
}

.hero h1 {
  font-size: 3rem;
  margin-bottom: 1rem;
  color: white;
}

.subheadline {
  font-size: 1.5rem;
  margin-bottom: 2rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.cta {
  margin-top: 2rem;
}

.cta-button {
  display: inline-block;
  background-color: var(--color-accent);
  color: white;
  font-weight: bold;
  padding: 1rem 2rem;
  text-decoration: none;
  border-radius: 5px;
  font-size: 1.2rem;
  transition: background-color 0.3s ease;
}

.cta-button:hover {
  background-color: white;
  color: var(--color-accent);
}

/* Features Section */
.features {
  padding: 4rem 0;
  background-color: #f5f5f5;
}

.features .container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.feature {
  flex-basis: 30%;
  margin-bottom: 2rem;
  padding: 1.5rem;
  background-color: white;
  border-radius: 5px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* Signup Form Section */
.signup {
  padding: 4rem 0;
  text-align: center;
  background-color: var(--color-primary);
  color: white;
}

.signup h2 {
  color: white;
  margin-bottom: 2rem;
}

form {
  max-width: 500px;
  margin: 0 auto;
}

.form-group {
  margin-bottom: 1rem;
}

input {
  width: 100%;
  padding: 1rem;
  border: none;
  border-radius: 5px;
  font-family: var(--font-body);
  font-size: 1rem;
}

button {
  background-color: var(--color-accent);
  color: white;
  border: none;
  padding: 1rem 2rem;
  font-size: 1rem;
  font-weight: bold;
  border-radius: 5px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

button:hover {
  background-color: white;
  color: var(--color-accent);
}

/* Footer */
footer {
  padding: 2rem 0;
  background-color: #333;
  color: white;
  text-align: center;
}

/* Responsive Design */
@media (max-width: 768px) {
  .features .container {
    flex-direction: column;
  }
  
  .feature {
    flex-basis: 100%;
  }
  
  .hero h1 {
    font-size: 2.5rem;
  }
  
  .subheadline {
    font-size: 1.2rem;
  }
}
